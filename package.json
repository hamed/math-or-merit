{
  "name": "math-or-merit",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "research": "vite-node scripts/research.ts",
    "script:lint": "node scripts/script.ts lint",
    "script:pdf": "cd script && latexmk",
    "script:watch": "cd script && latexmk -pvc -view=none main.tex",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage baseLocale --emit-ts-declarations",
    "check": "npm run messages && svelte-check --no-tsconfig --ignore \"archive\" --fail-on-warnings && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.13.2",
    "mdsvex": "^0.12.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
